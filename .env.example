# ============================================================
# 🌦️ WeatherDash — Environment Variables
# Copy this file to .env and fill in your API keys
# ============================================================

# ── Backend ──────────────────────────────────────────────────
# OpenWeatherMap API key (free tier at https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Anthropic Claude API key for AI weather summaries (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
# Leave unset to use SQLite (file-based, great for local dev without Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/weather_db

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=weather_db

# ── Frontend (must be prefixed with NEXT_PUBLIC_) ─────────────
# Backend API URL (change if deploying)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Maps JavaScript API key (https://console.cloud.google.com)
# Enable: Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# YouTube Data API v3 key (https://console.cloud.google.com)
# Enable: YouTube Data API v3
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_data_api_key_here
